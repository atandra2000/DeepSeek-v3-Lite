  "cards": [
    {
      "dot": "cyan",
      "title": "Shared pipeline",
      "items": [
        "data/prepare_data.py is a shim over LLM/shared_data",
        "Only the tokenizer differs per project — shards stay comparable",
        "Mixture.yaml is authoritative: 8.0B tokens, weights sum to 1.0"
      ]
    },
    {
      "dot": "emerald",
      "title": "Crash isolation",
      "items": [
        "Each stage runs as its own subprocess with per-source state files",
        "Shards are written tmp → fsync → os.replace, never torn",
        "The manifest is rebuilt from the shard files actually on disk",
        "manifest.json records SHA-256, provenance, and per-source stats"
      ]
    },
    {
      "dot": "amber",
      "title": "Training boundary",
      "items": [
        "Disk stays uint32 (32 GB); int64 cast happens once in train_step",
        "Documents are EOS-separated — no headers, no padding",
        "Windows never pad: the partial tail is dropped"
      ]
    }
  ]
