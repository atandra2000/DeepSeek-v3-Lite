  "cards": [
    {
      "dot": "cyan",
      "title": "Memory arithmetic",
      "items": [
        "Weights 0.8 GB + AdamW state 4.9 GB + activations ~10.1 GB",
        "Transient logits (B·S·V) add ~3.1 GB — largest single activation",
        "Total lands ~30–35 GB inside the 80 GB budget"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why FP32 master weights",
      "items": [
        "BF16 has only ~3 decimal digits — small updates would round away",
        "AdamW moments are FP32; fused kernel updates in one pass",
        "Autocast casts transiently for compute, never mutates parameters"
      ]
    },
    {
      "dot": "amber",
      "title": "LR and stability",
      "items": [
        "μP transfers a tuned reference LR across scales via sqrt(N_ref/N)",
        "YAML lr is dead config while mup_lr: true — edit mup_lr_reference",
        "Warmup exists because Adam's early moments are miscalibrated"
      ]
    }
  ]
